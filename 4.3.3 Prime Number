#include <iostream>
using namespace std;

int main() {
    cout << "Prime numbers between 3 and 100:" << endl;

    for (int n = 3; n <= 100; n++) {
        bool isPrime = true;

        for (int i = 2; i < n; i++) {
            if (n % i == 0) {
                isPrime = false;  
                break;
            }
        }

        if (isPrime) {
            cout << n << " ";
        }
    }

    cout << endl;
    return 0;
}
